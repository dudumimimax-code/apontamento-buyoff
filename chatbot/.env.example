# Copie para .env e preencha:   cp .env.example .env
# O .env tem segredos: NUNCA suba para o GitHub (já está no .gitignore).
# Para gerar valores aleatórios:  openssl rand -hex 24

# ---- Planilha (Apps Script) -------------------------------------------------
# A mesma URL do ENDPOINT do app.js (termina em /exec)
BUYOFF_APPS_SCRIPT_URL=https://script.google.com/macros/s/COLE_AQUI/exec
# A CHAVE_CONTROLE do Apps Script (função mostrarChaves). Só leitura.
BUYOFF_CHAVE_CONTROLE=

# ---- Quem pode pedir relatório ----------------------------------------------
# Números com DDI e DDD, só dígitos (ex.: 5511987654321), e/ou ids de grupos (…@g.us).
# Separe por vírgula. Em grupo autorizado, qualquer participante pode pedir (com /).
# Vazio = ninguém recebe resposta.
BUYOFF_AUTORIZADOS=5511900000000

# Para onde vai o relatório automático das 07:00 (ids …@g.us ou …@c.us, separados por vírgula).
# Vazio = sem relatório automático.
BUYOFF_DESTINOS_AGENDADOS=

# ---- Segredos internos (gere valores aleatórios) -----------------------------
# Chave da API do WAHA (o n8n usa para enviar as mensagens)
WAHA_API_KEY=
# Token que o WAHA manda ao n8n em cada mensagem (prova que veio do WAHA)
BUYOFF_WEBHOOK_TOKEN=
# Criptografia das credenciais do n8n. Gere uma vez e guarde: se perder, o n8n não abre os dados salvos.
N8N_ENCRYPTION_KEY=

# ---- Painel do WAHA (http://localhost:3000/dashboard) -------------------------
WAHA_PAINEL_USUARIO=admin
WAHA_PAINEL_SENHA=
